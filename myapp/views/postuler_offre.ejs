<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Demande pour devenir recruteur</title>
  </head>

<div class="container marketing">
  <div class="bg-body-tertiary p-5 rounded mt-4">
    <h2 class="mb-4 text-primary text-center">Postuler à l'offre : <%= offre.intitule %></h2>
    <form action="/offre/postuler/<%= offre.id_offre %>" method="post" enctype="multipart/form-data" class="row g-3 justify-content-center">
      <div class="col-12 text-center mb-2">
        <span class="fw-bold">Documents demandés :</span> <%= offre.liste_piece_demande %>
      </div>
      <% const pieces = (offre.liste_piece_demande || '').split(',').map(p => p.trim()).filter(Boolean); %>
      <% pieces.forEach(function(piece, i) { %>
        <div class="col-md-6">
          <label class="form-label">Pièce jointe : <%= piece %></label>
          <input type="file" class="form-control" name="pieces[<%= piece.replace(/\s+/g, '_').toLowerCase() %>]" required aria-label="<%= piece %>" multiple>
        </div>
      <% }); %>
      <div class="col-12 text-center mt-3">
        <button class="btn btn-primary btn-lg px-4" type="submit">
          <i class="bi bi-send me-2"></i>Envoyer la candidature
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('component/footer') %>
