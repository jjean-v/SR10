<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Demande pour devenir recruteur</title>
    <style>
      
      .container.marketing {
        max-width: 500px;
        margin: 40px auto;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 2.5rem 2rem 2rem 2rem;
      }
      .card-demande h1 {
        font-size: 1.7rem;
        font-weight: 700;
        color: #0d6efd;
      }
      .form-floating label { left: 0.75rem; }
      .btn-primary {
        background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .logo-demande {
        display: block;
        margin: 0 auto 1.2rem auto;
        width: 64px;
        height: 64px;
      }
    </style>
  </head>
  <body>
<%- include('component/header', {
      pageTitle: 'Demande pour devenir recruteur',
      current: 'demande',
      prenom: prenom, nom: nom, role: role
    }) %>
<div class ="container marketing">
  <div class="bg-body-tertiary p-5 rounded mt-4">
      <img src="/assets/brand/bootstrap-logo.svg" alt="Logo" class="logo-demande">
      <h1 class="mb-4 text-center">Demande pour devenir recruteur</h1>
      <form action="/utilisateurs/demande_recruteur" method="post" id="form-recruteur">
        <div class="form-floating mb-4">
          <select class="form-select" id="organisation" name="siren" aria-label="Organisation">
            <option value="" disabled selected>Choisissez votre organisation</option>
            <% organisations.forEach(orga => { %>
              <option value="<%= orga.siren %>">
                <%= orga.nom %> – <%= orga.adresse %>
              </option>
            <% }) %>
            <option value="new">Créer une nouvelle organisation</option>
          </select>
          <label for="organisation">Organisation</label>
        </div>
        <div id="new-organisation-fields" style="display:none;">
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="nom_orga" name="nom_orga" placeholder="Nom de l'organisation">
            <label for="nom_orga">Nom de l'organisation</label>
          </div>
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="type_orga" name="type_orga" placeholder="Type d'organisation">
            <label for="type_orga">Type d'organisation</label>
          </div>
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="adresse_orga" name="adresse_orga" placeholder="Adresse">
            <label for="adresse_orga">Adresse</label>
          </div>
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="siren_orga" name="siren_orga" placeholder="SIREN">
            <label for="siren_orga">SIREN</label>
          </div>
        </div>
        <button class="w-100 btn btn-lg btn-primary" type="submit">
          <i class="bi bi-send me-2"></i>Envoyer la demande
        </button>
      </form>
      <script>
        const orgaSelect = document.getElementById('organisation');
        const newOrgaFields = document.getElementById('new-organisation-fields');
        orgaSelect.addEventListener('change', function() {
          if (this.value === 'new') {
            newOrgaFields.style.display = 'block';
            document.getElementById('nom_orga').required = true;
            document.getElementById('type_orga').required = true;
            document.getElementById('adresse_orga').required = true;
            document.getElementById('siren_orga').required = true;
          } else {
            newOrgaFields.style.display = 'none';
            document.getElementById('nom_orga').required = false;
            document.getElementById('type_orga').required = false;
            document.getElementById('adresse_orga').required = false;
            document.getElementById('siren_orga').required = false;
          }
        });
      </script>
  </div>
</div>
<%- include('component/footer') %>
<%- include('component/dark_light_mode') %>
  </body>
</html>