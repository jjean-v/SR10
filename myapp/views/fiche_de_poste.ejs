
           

<!DOCTYPE html>
<html>
    <head>
        <script src="/assets/js/color-modes.js"></script>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link href="/stylesheets/style.css" rel="stylesheet">
        <title>Recruteur</title>  
        <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
 
      </head>
    <body>
        <%- include('component/header') %> 
        

        <div class="container marketing">

            <div class="bg-body-tertiary p-5 rounded ">
                <h2>Espace Recruteur</h2>
            </div>
           
            <div class="d-flex gap-2 justify-content-center py-5">
                <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateur/espace_recruteur'">
                  Gestion des Offres
                </button>
                <button class="col with gx-4 btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/fiche_de_poste'">
                  Gestion des Fiche de poste
                </button>
                <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/candidatures'">
                  Gestion des Candidatures
                  </button>
            </div>
        </div>
            <!-- START THE FEATURETTES -->
        
            
        <div class="container marketing">
    
        <div class="bg-body-tertiary p-5 rounded">
            <div class="row">
                <div class="col-md-9">    
                    <h2>Gestion des Fiches de Poste</h2>
                </div>
            
        
                <div class="col-md-3 align-items-center">
                    <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/new_fiche_de_poste'">
                        Ajouter une Fiche de Poste
                    </button>
                </div>
            </div>
            <hr class="featurette-divider">
    
    
            <div class="align-items-center justify-content-center">
                <div class="list-group">

                    <% fiche_de_poste.forEach((fiche_de_poste)=> { %>

                    <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">
                    <div class="d-flex gap-2 w-100">
                        <div class="col-2">
                            <h6 class="mb-0"> <%= fiche_de_poste.intitule %> </h6>
                            <p class="mb-0 opacity-75"> <%= fiche_de_poste.statut %> </p>
                        </div>
                        <div class = "col-2">
                            <h6 class="mb-0"> <%= fiche_de_poste.type_metier %></h6>
                        </div>
                        <div class = "col-2">
                            <h6 class="mb-0"> <%= fiche_de_poste.salaire %> / mois</h6>
                        </div>
                        <div class = "col-2">
                            <h6 class="mb-0"> <%= fiche_de_poste.lieu %></h6>
                        </div>
                    </div>
                        
                    <div class=" d-flex gap-3">
                        <div>
                            <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                                Modifier
                            </button>
                        </div>
                        <div>
                            <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                                Supprimer
                            </button>
                        </div>
                    </div>
                    </a>

                    <% }) %>


                </div>
            </div>
        </div>
   
        <%- include('component/dark_light_mode') %>
        <%- include('component/footer') %>
    </body>
</html>


