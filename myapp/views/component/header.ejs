      <svg class="bi me-2" width="40" height="32"><use xlink:href="#bootstrap"/></svg>
      <span class="fs-4"><%= prenom %> <%= nom %></span>
    </a>

    <ul class="nav nav-pills">
      <li class="nav-item"><a href="#" class="nav-link active" aria-current="page">Accueil</a></li>
      <li class="nav-item"><a href="#" class="nav-link">Mon Espace</a></li>
      <li class="nav-item"><a href="#" class="nav-link">FAQ</a></li>
      <li class="nav-item"><a href="#" class="nav-link">A Propos</a></li>
      <li class="nav-item">
        <% if (role === 'candidat') { %>
          <form action="/offre/espace_recruteur" method="get" style="display:inline;">
            <button type="submit" class="btn btn-warning ms-3">Devenir Recruteur</button>
          </form>
        <% }%>
      </li>
    </ul>
  </header>
</div>