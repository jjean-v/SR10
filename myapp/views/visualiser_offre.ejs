<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <script src="/assets/js/color-modes.js"></script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/login.css" rel="stylesheet">

   
    <title>Visualiser l'Offre</title>

    
    <!-- Custom styles for this template -->
  </head>

  <body>
  
    <%- include('component/header') %> 

   <div class="container marketing">

      <div class="bg-body-tertiary p-5 rounded">
        <h2>Mes Candidatures</h2>
      </div>
       <div class="d-flex gap-2 justify-content-center py-5">
          <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/offre/candidat'">
            Lister les Offres
          </button>
          <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/candidatures/candidat'">
            Mes Candidatures
          </button>
        
      </div>

    </div>
   

   
        
    <div class="container">
        
    <main>

        <div class="bg-body-tertiary p-5 rounded">

            <div class="col-md-10">    
                <h2>Informations sur l'Offre</h2>
            </div>
            <hr class="featurette-divider">

            <div class="row g-5">

                <div class="row-g-5">

                    <h4> <%= data.intitule_fiche %></h4>
                        <div class="row-4"><strong>Entreprise : </strong><%= data.nom_orga %></div>
                        <div class="row-4"><strong>Lieu : </strong><%= data.lieu %></div>
                        <div class="row-4"><strong>Salaire : </strong><%= data.salaire %> € / mois</div>
                        <div class="row-4"> <strong>Horaire : </strong><%= data.rythme %> h / semaine</div>

                </div>
            </div>
            <p></p>
            <h4> Description de l'Offre</h4>
            <p></p>
            <div>
                <%= data.description %>
            </div>
            <p></p>
            <h4> Liste des pièces demandées</h4>
            <p
            <div>
                <%= data.liste_piece_demande %>
            </div>

            <div class="text-center mt-4">
                <form action="/offre/postuler/<%= data.id_offre %>" method="get" style="display:inline;">
                    <button class="btn btn-success btn-lg px-4" type="submit">
                        Postuler à cette offre
                    </button>
                </form>
            </div>

        

        </div>
       

      
    </main>
   
    <%- include('component/dark_light_mode') %>
    <%- include('component/footer') %>
   
    </div>

    <script src="checkout.js"></script>
</body>
</html>
