<h1><%= message %></h1>
<% if (error.status) { %>
  <h2><%= error.status %></h2>
<% } %>
<% if (error.stack) { %>
  <pre><%= error.stack %></pre>
<% } %>
<!-- Message personnalisé pour non-recruteur -->
<% if (message === "Vous n'êtes pas recruteur.") { %>
  <div style="color: #b94a48; font-weight: bold;">Accès réservé aux recruteurs.</div>
<% } %>
