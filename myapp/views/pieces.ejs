<!-- views/pieces.ejs -->

<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css"             rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Recruteur</title>
  </head>
  <body>
    <%- include('component/header') %>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Candidat</h2>
      </div>
      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion des Offres
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion de vos Candidatures
        </button>
        <button class="col with gx-4 btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion de votre Dossier
          </button>
    </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row mb-3">
          <div class="col-md-8">
            <h2>Gestion des Pièces Jointes</h2>
          </div>
          <div class="col-md-4">
            <form class="d-flex" role="search">
              <input
                type="search"
                class="form-control form-control-dark text-bg-dark"
                placeholder="Search..."
                aria-label="Search">
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="list-group">
          <% pieces.forEach(p => { %>
            <a
              href="#"
              class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3"
              aria-current="true">
              
              <!-- Conteneur principal flex, colonnes centrées -->
              <div class="d-flex align-items-center w-100">
                <div class="col-2 text-center">
                  <h6 class="mb-0">
                    <%= p.prenom_utilisateur %> <%= p.nom_utilisateur %>
                  </h6>
                </div>
                <div class="col-3 text-center text-truncate">
                  <h6 class="mb-0"><%= p.intitule_fiche_poste %></h6>
                </div>
                <div class="col-2 text-center">
                  <h6 class="mb-0"><%= p.nom %></h6>
                </div>
                <div class="col-2 text-center">
                  <h6 class="mb-0"><%= p.type %></h6>
                </div>
                <div class="col-2 text-center">
                  <h6 class="mb-0"><%= p.taille %> Mo</h6>
                </div>
              </div>

              <!-- Boutons d'action -->
              <div class="d-flex gap-3">
                <!-- Pas de modification pour pièce jointe, juste suppression -->
                <form action="/pieces/delete/<%= p.id_piece_jointe %>" method="post" style="margin:0;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette pièce jointe ?');">
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="submit">
                    Supprimer
                  </button>
                </form>
              </div>
            </a>
          <% }) %>
        </div>
      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
