<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Demande pour devenir recruteur</title>
    <style>
      body { background: #f8f9fa; }
      .card-demande {
        max-width: 500px;
        margin: 40px auto;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        background: #fff;
        padding: 2.5rem 2rem 2rem 2rem;
      }
      .card-demande h1 {
        font-size: 1.7rem;
        font-weight: 700;
        color: #0d6efd;
      }
      .form-floating label { left: 0.75rem; }
      .btn-primary {
        background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .logo-demande {
        display: block;
        margin: 0 auto 1.2rem auto;
        width: 64px;
        height: 64px;
      }
    </style>
  </head>
    <body>
        <%- include('component/header') %> 
        <div class="container marketing">
            <div class="bg-body-tertiary p-5 rounded ">
                <h2>Espace Candidat</h2>
            </div>
           
            <div class="d-flex gap-2 justify-content-center py-5">
                <button class="col with gx-4 gutters btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/offre/candidat'">
                  Lister les Offres
                </button>
                <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/candidatures/candidat'">
                  Mes Candidatures
                </button>
               
            </div>

            <div class="bg-body-tertiary p-5 rounded">
                <div class="col-md-8">
                    <h2>Liste des Offres d'Emploi</h2>
                </div>
                <form class="row g-3 mb-4" method="get" action="/offre/candidat/recherche">
                  <div class="col-md-4">
                    <input type="text" class="form-control" name="q" placeholder="Mots-clés (intitulé, lieu, description...)" value="<%= typeof recherche !== 'undefined' ? recherche : '' %>">
                  </div>
                  <div class="col-md-2">
                    <input type="text" class="form-control" name="metier" placeholder="Métier" value="<%= typeof metier !== 'undefined' ? metier : '' %>">
                  </div>
                  <div class="col-md-2">
                    <input type="text" class="form-control" name="salaire_min" placeholder="Salaire min" value="<%= typeof salaire_min !== 'undefined' ? salaire_min : '' %>">
                    <input type="text" class="form-control mt-1" name="salaire_max" placeholder="Salaire max" value="<%= typeof salaire_max !== 'undefined' ? salaire_max : '' %>">
                  </div>
                  <div class="col-md-2">
                    <select class="form-select" name="tri">
                      <option value="date">Date</option>
                      <option value="salaire">Salaire</option>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <select class="form-select" name="statut_poste">
                        <option value="">Statut du poste</option>
                        <option value="Cadre" <%= statut_poste === 'Cadre' ? 'selected' : '' %>>Cadre</option>
                        <option value="Etam" <%= statut_poste === 'Etam' ? 'selected' : '' %>>Etam</option>
                        <option value="Intermitant" <%= statut_poste === 'Intermitant' ? 'selected' : '' %>>Intermitant</option>
                        <option value="Stagiaire" <%= statut_poste === 'Stagiaire' ? 'selected' : '' %>>Stagiaire</option>
                        <option value="Alternant" <%= statut_poste === 'Alternant' ? 'selected' : '' %>>Alternant</option>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Rechercher</button>
                  </div>
                </form>
                <hr class="featurette-divider">


                <div class="align-items-center justify-content-center mt-4">
                    <div class="list-group">
                        <% offre.forEach((offre)=> { %>
                        <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">
                            <div class="d-flex gap-2 w-100">
                                <div class="col-5">
                                    <h6 class="mb-0"> <%= offre.intitule %> </h6>
                                    <p class="mb-0 opacity-75"> <%= offre.date_validite.toISOString().split('T')[0] %> </p>
                                </div>
                                <div class = "col-3">
                                    <h6 class="mb-0"><%= offre.etat %></h6>
                                </div>
                                <div class = "col-2">
                                    <h6 class="mb-0"> <%= offre.liste_piece_demande %></h6>
                                </div>
                            </div>
                            <div class="d-flex col-2 gutters">
                                <form action="/candidatures/visualiser_offre" method="post" style="margin:0;">
                                    <input type="hidden" name="id_offre" value="<%= offre.id_offre %>">
                                    <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="submit">
                                        Visualiser l'Offre
                                    </button>
                                </form>
                            </div>
                            <div class="d-flex  col-1 gutters">
                                <form action="/offre/postuler/<%= offre.id_offre %>" method="get" style="margin:0;">
                                    <button class="col with gx-4 gutters btn btn-success d-inline-flex align-items-center justify-content-center" type="submit">
                                        Postuler
                                    </button>
                                </form>
                            </div>
                        </a>
                        <% }) %>
                    </div>
                </div>
                <!-- Pagination -->
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                  <nav aria-label="Pagination offres" class="mt-4">
                    <ul class="pagination justify-content-center">
                      <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= (i === page) ? 'active' : '' %>">
                          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                      <% } %>
                    </ul>
                  </nav>
                <% } %>
            </div>
        </div>
        <%- include('component/dark_light_mode') %>
        <%- include('component/footer') %>
    </body>
</html>
