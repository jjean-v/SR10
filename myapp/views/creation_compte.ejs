<!-- views/pieces.ejs -->

<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css"             rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Recruteur</title>
  </head>
  <body>
    <%- include('component/header') %>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Candidat</h2>
      </div>
      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="btn btn-primary">Gestion des Offres</button>
        <button class="btn btn-primary">Gestion des Fiches de poste</button>
        <button class="btn btn-primary">Gestion des Pièces Jointes</button>
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row mb-3">
          <div class="col-md-8">
            <h2>Votre compte a été crée</h2>
          </div>
          <div class="col-md-4">
            <form class="d-flex" role="search">
              <input
                type="search"
                class="form-control form-control-dark text-bg-dark"
                placeholder="Search..."
                aria-label="Search">
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="list-group">
          votre compte a été crée avec succès
        </div>
      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
