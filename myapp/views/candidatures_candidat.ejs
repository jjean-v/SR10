<!-- views/candidatures.ejs -->

<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css"           rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Candidat</title>
  </head>
  <body>
    <%- include('component/header') %>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Candidat</h2>
      </div>
       <div class="d-flex gap-2 justify-content-center py-5">
          <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/offre/candidat'">
            Lister les Offres
          </button>
          <button class="col with gx-4 btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/candidatures/candidat'">
            Mes Candidatures
          </button>
          
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row">
          <div class="col-md-8">
            <h2>Gestion des Candidatures</h2>
          </div>
          <div class="col-md-4 align-items-center">
            <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
              <input type="search"
                     class="form-control form-control-dark text-bg-dark"
                     placeholder="Search..."
                     aria-label="Search">
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="align-items-center justify-content-center">
          <div class="list-group">
            <% candidatures.forEach(c => { %>
              <a href="#"
                 class="list-group-item list-group-item-action d-flex gap-3 py-3"
                 aria-current="true">
                <div class="d-flex gap-2 w-100">
                  <div class="col-4">
                    <h6 class="mb-0"><%= c.intitule_fiche_poste %></h6>
                    <p class="mb-0 opacity-75">
                      <%= c.date_candidature.toISOString().split('T')[0] %>
                    </p>
                  </div>
                 
                  <div class="col-2">
                    <h6 class="mb-0">
                      <%= c.lieu %>
                    </h6>
                  </div>
                   <div class="col-2">
                    <h6 class="mb-0">
                      <%= c.etat_candidature %>
                    </h6>
                  </div>
                  <div class="d-flex gap-3">
                    <% if (c.etat_candidature === 'admis') { %>
                      <form action="/candidatures/valider_offre" method="post" style="margin:0;">
                          <input type="hidden" name="id_offre" value="<%= c.id_offre %>">
                          <input type="hidden" name="id_user" value="<%= c.id_user %>">
                          <button class="col with gx-4 gutters btn btn-success d-inline-flex align-items-center justify-content-center" type="submit">
                              Accepter l'Offre
                          </button>
                      </form>
                      <% } %>
                       
                    <form action="/candidatures/visualiser_offre" method="post" style="margin:0;">
                        <input type="hidden" name="id_offre" value="<%= c.id_offre %>">
                        <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="submit">
                            Visualiser l'Offre
                        </button>
                    </form>

                  </div>
                </div>
               
              </a>
            <% }) %>
          </div>
        </div>
        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <nav aria-label="Pagination candidatures" class="mt-4">
            <ul class="pagination justify-content-center">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= (i === page) ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>

      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
