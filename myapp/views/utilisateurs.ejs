<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <title>Administrateur</title>  
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <%- include('component/header') %> 

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Administrateur</h2>
      </div>

      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion des Utilisateurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion des Recruteurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
          Gestion des Organisations
        </button>
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row">
          <div class="col-md-8">
            <h2>Gestion des Utilisateurs</h2>
          </div>
          <div class="col-md-4 align-items-center">
            <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
              <input type="search" class="form-control form-control-dark text-bg-dark" placeholder="Search..." aria-label="Search">
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="align-items-center justify-content-center">
          <div class="list-group">
            <% utilisateurs.forEach((utilisateurs) => { %>
              <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">

                <!-- Partie corrigée : photo retirée -->
                <div class="d-flex align-items-center w-100">
                  <div class="me-3 flex-shrink-0">
                    <h6 class="mb-0"><%= utilisateurs.id_user %></h6>
                  </div>
                  <div class="me-3 flex-shrink-0">
                    <h6 class="mb-0"><%= utilisateurs.nom %></h6>
                  </div>
                  <div class="me-3 flex-shrink-0">
                    <h6 class="mb-0"><%= utilisateurs.prenom %></h6>
                  </div>
                  <div class="flex-grow-1 text-truncate">
                    <h6 class="mb-0"><%= utilisateurs.email %></h6>
                  </div>
                  <div class="ms-auto flex-shrink-0 text-end">
                    <h6 class="mb-0"><%= utilisateurs.role %></h6>
                  </div>
                </div>
                <!-- /Fin partie corrigée -->

                <div class="d-flex gap-3">
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                    Modifier
                  </button>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                    Supprimer
                  </button>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
