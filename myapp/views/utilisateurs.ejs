<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <title>Administrateur</title>  
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <%- include('component/header') %> 

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Administrateur</h2>
      </div>

      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="col with gx-4 gutters btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs'">
          Gestion des Utilisateurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs/recruteur'" >
          Gestion des Recruteurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/organisations'">
          Gestion des Organisations
        </button>
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row">
          <div class="col-md-8">
            <h2>Gestion des Utilisateurs</h2>
          </div>
          <div class="col-md-4 align-items-center">
            <form class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
              <input type="search" class="form-control form-control-dark text-bg-dark" placeholder="Search..." aria-label="Search">
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="align-items-center justify-content-center">
          <div class="list-group">
            <% utilisateurs.forEach((utilisateurs) => { %>
              <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">

              
               
                <div class="d-flex gap-2 w-100">
                  <div class="col-3">
                      <h6 class="mb-0"> <%= utilisateurs.prenom %> <%= utilisateurs.nom %> </h6>
                      <p class="mb-0 opacity-75"><%= utilisateurs.etat_compte %>  </p>
                  </div>
                  <div class = "col-3">
                      <h6 class="mb-0"><%= utilisateurs.email %></h6>
                  </div>
                  <div class = "col-2">
                      <h6 class="mb-0"> <%= utilisateurs.role %></h6>
                  </div>
                 
                </div>

                <div class="d-flex gap-3">
                  <form method="POST" action="/utilisateurs/set_admin" style="display:inline;">
                    <input type="hidden" name="id_user" value="<%= utilisateurs.id_user %>" />
                    <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="submit">
                      Admin
                    </button>
                  </form>
                  <form method="POST" action="/utilisateurs/delete" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                    <input type="hidden" name="id_user" value="<%= utilisateurs.id_user %>" />
                    <button class="btn btn-danger d-inline-flex align-items-center justify-content-center" type="submit">
                      Supprimer
                    </button>
                  </form>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <nav aria-label="Pagination utilisateurs" class="mt-4">
            <ul class="pagination justify-content-center">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= (i === page) ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-info mt-3" role="alert">
          <%= message %>
        </div>
      <% } %>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
