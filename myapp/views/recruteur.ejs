<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <title>Administrateur</title>  
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <%- include('component/header') %> 

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Administrateur</h2>
      </div>

      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs'">
          Gestion des Utilisateurs
        </button>
        <button class="col with gx-4 btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs/recruteur'">
          Gestion des Recruteurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/organisations'">
          Gestion des Organisations
        </button>
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row">
          <div class="col-md-8">
            <h2>Gestion des Recruteurs</h2>
          </div>
          <div class="col-md-4 align-items-center">
            <form class="row g-2 mb-3 mb-lg-0 me-lg-3" role="search" method="get" action="/utilisateurs/recruteur">
              <div class="col-8">
                <input type="search" class="form-control" name="q" placeholder="Rechercher un recruteur (nom, prénom, email)" value="<%= typeof recherche !== 'undefined' ? recherche : '' %>">
              </div>
              <div class="col-4">
                <button type="submit" class="btn btn-primary w-100">Rechercher</button>
              </div>
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="align-items-center justify-content-center">
          <div class="list-group">
            <% utilisateurs.forEach((utilisateurs) => { %>
              <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">

              
               
                <div class="d-flex gap-2 w-100">
                  <div class="col-3">
                      <h6 class="mb-0"> <%= utilisateurs.prenom %> <%= utilisateurs.nom %> </h6>
                      <p class="mb-0 opacity-75"><%= utilisateurs.etat_compte %>  </p>
                  </div>
                  <div class = "col-3">
                      <h6 class="mb-0"><%= utilisateurs.email %></h6>
                  </div>
                  <div class = "col-2">
                      <h6 class="mb-0"> <%= utilisateurs.role %></h6>
                  </div>
                 
                </div>

                <div class="d-flex gap-3">
                  <% if (utilisateurs.role_recruteur === 'attente') { %>
                    <form action="/utilisateurs/valider_recruteur" method="post" style="display:inline;">
                      <input type="hidden" name="id_user" value="<%= utilisateurs.id_user %>">
                      <button class="btn btn-success d-inline-flex align-items-center justify-content-center" type="submit">
                        Valider
                      </button>
                    </form>
                  <% } %>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                    Modifier
                  </button>
                  <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="button">
                    Supprimer
                  </button>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
