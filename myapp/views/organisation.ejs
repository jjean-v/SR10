<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <title>Administrateur</title>  
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <%- include('component/header') %> 

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <h2>Espace Administrateur</h2>
      </div>

      <div class="d-flex gap-2 justify-content-center py-5">
        <button class="col with gx-4 gutters btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs'">
          Gestion des Utilisateurs
        </button>
        <button class="col with gx-4 btn btn-primary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/utilisateurs/recruteur'" >
          Gestion des Recruteurs
        </button>
        <button class="col with gx-4 btn btn-secondary d-inline-flex align-items-center justify-content-center" type="button" onclick="window.location.href='/organisations'">
          Gestion des Organisations
        </button>
      </div>
    </div>

    <div class="container marketing">
      <div class="bg-body-tertiary p-5 rounded">
        <div class="row">
          <div class="col-md-8">
            <h2>Gestion des Organisations</h2>
          </div>
          <div class="col-md-4 align-items-center">
            <form class="row g-2 mb-3 mb-lg-0 me-lg-3" role="search" method="get" action="/organisations">
              <div class="col-8">
                <input type="search" class="form-control" name="q" placeholder="Rechercher une organisation (nom, siren, type, adresse)" value="<%= typeof recherche !== 'undefined' ? recherche : '' %>">
              </div>
              <div class="col-4">
                <button type="submit" class="btn btn-primary w-100">Rechercher</button>
              </div>
            </form>
          </div>
        </div>
        <hr class="featurette-divider">

        <div class="align-items-center justify-content-center">
          <div class="list-group">
            <% organisation.forEach((organisation) => { %>
              <a href="#"
                 class="list-group-item list-group-item-action d-flex gap-3 py-3"
                 aria-current="true">

                <!-- photo retirée -->

                <div class="d-flex gap-2 w-100">
                  <div class="col-2">
                    <h6 class="mb-0"><%= organisation.nom %></h6>
                    <p class="mb-0 opacity-75"><%= organisation.siren %></p>
                  </div>
                  <div class="col-1">
                    <h6 class="mb-0"><%= organisation.type %></h6>
                  </div>
                  <div class="col-4">
                    <h6 class="mb-0"><%= organisation.adresse %></h6>
                  </div>
                  <div class="col-1">
                    <h6 class="mb-0"><%= organisation.etat_orga %></h6>
                  </div>
                </div>

                <div class="d-flex gap-3">
                 
                  <% if (organisation.etat_orga == 'validé') { %>
                    <button class="btn btn-primary d-inline-flex align-items-center justify-content-center"
                        type="button">
                      Modifier
                    </button>
                    <% } else { %>
                      <form action="/organisations/accepter" method="post" style="display:inline;">
                        <input type="hidden" name="siren" value="<%= organisation.siren %>">
                        <button class="btn btn-primary d-inline-flex align-items-center justify-content-center" type="submit">
                          Accepter
                        </button>
                      </form>
                    <% } %>
                  <form action="/organisations/supprimer" method="post" style="display:inline;">
                    <input type="hidden" name="siren" value="<%= organisation.siren %>">
                    <button class="btn btn-danger d-inline-flex align-items-center justify-content-center" type="submit">
                      Supprimer
                    </button>
                  </form>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <nav aria-label="Pagination organisations" class="mt-4">
            <ul class="pagination justify-content-center">
              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= (i === page) ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
      </div>

      <%- include('component/dark_light_mode') %>
      <%- include('component/footer') %>
    </div>
  </body>
</html>
