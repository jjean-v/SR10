<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/login.css" rel="stylesheet">
    <title>Nouvelle Fiche de Poste</title>
  </head>

  <body class="d-flex align-items-center py-4 bg-body-tertiary">
    <main class="form-signin w-100 m-auto">
      <form action="/new_fiche_de_poste" method="POST">
        <img class="mb-4" src="/assets/brand/bootstrap-logo.svg" alt="" width="72" height="57">
        <h1 class="h3 mb-3 fw-normal">Créer une Fiche de Poste</h1>

        <div class="form-floating mb-3">
          <input type="text"
                 class="form-control"
                 id="floatingIntitule"
                 name="intitule"
                 placeholder="Intitulé"
                 maxlength="50"
                 required>
          <label for="floatingIntitule">Intitulé</label>
        </div>

        <div class="form-floating mb-3">
          <select class="form-select"
                  id="floatingStatut"
                  name="statut_poste"
                  aria-label="Statut du Poste"
                  required>
            <option value="" disabled selected>Choisir le statut</option>
            <option value="Cadre">Cadre</option>
            <option value="Etam">Etam</option>
            <option value="Intermitant">Intermittent</option>
            <option value="Stagiaire">Stagiaire</option>
            <option value="Alternant">Alternant</option>
          </select>
          <label for="floatingStatut">Statut du Poste</label>
        </div>

        <div class="form-floating mb-3">
          <input type="text"
                 class="form-control"
                 id="floatingTypeMetier"
                 name="type_metier"
                 placeholder="Type de Métier"
                 maxlength="50"
                 required>
          <label for="floatingTypeMetier">Type de Métier</label>
        </div>

        <div class="form-floating mb-3">
          <input type="number"
                 class="form-control"
                 id="floatingSalaire"
                 name="salaire"
                 placeholder="Salaire"
                 step="0.01"
                 required>
          <label for="floatingSalaire">Salaire (€)</label>
        </div>

        <div class="form-floating mb-3">
          <input type="number"
                 class="form-control"
                 id="floatingRythme"
                 name="rythme"
                 placeholder="Rythme"
                 required>
          <label for="floatingRythme">Rythme</label>
        </div>

        <div class="form-floating mb-3">
          <input type="text"
                 class="form-control"
                 id="floatingLieu"
                 name="lieu"
                 placeholder="Lieu"
                 maxlength="255"
                 required>
          <label for="floatingLieu">Lieu</label>
        </div>

        <div class="form-floating mb-4">
          <textarea class="form-control"
                    placeholder="Description"
                    id="floatingDescription"
                    name="description"
                    style="height: 100px"
                    maxlength="255"
                    required></textarea>
          <label for="floatingDescription">Description</label>
        </div>

        <button class="btn btn-primary w-100 py-2" type="submit">Créer</button>
        <p class="mt-5 mb-3 text-body-secondary">&copy; 2017–2025</p>
      </form>
    </main>

    <%- include('component/dark_light_mode') %>
  </body>
</html>
