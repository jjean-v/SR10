<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Confirmation de Postulation</title>
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="alert alert-success">
            <% if (typeof message !== 'undefined') { %>
                <h2><%= message %></h2>
            <% } else { %>
                <h2>Votre candidature a bien été prise en compte !</h2>
                <p>Merci d'avoir postulé à l'offre n°<%= id_offre %>.</p>
            <% } %>
        </div>
        <a href="/utilisateurs" class="btn btn-primary">Retour à l'accueil</a>
    </div>
</body>
</html>
