<!DOCTYPE html>
<html>
  <head>
    <script src="/assets/js/color-modes.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <link href="/assets/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Demande pour devenir recruteur</title>
    <style>
      body { background: #f8f9fa; }
      .card-demande {
        max-width: 500px;
        margin: 40px auto;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        background: #fff;
        padding: 2.5rem 2rem 2rem 2rem;
      }
      .card-demande h1 {
        font-size: 1.7rem;
        font-weight: 700;
        color: #0d6efd;
      }
      .form-floating label { left: 0.75rem; }
      .btn-primary {
        background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .logo-demande {
        display: block;
        margin: 0 auto 1.2rem auto;
        width: 64px;
        height: 64px;
      }
    </style>
  </head>
<body>
    <div class="container mt-5">
        <div class="alert alert-success">
            <% if (typeof message !== 'undefined') { %>
                <h2><%= message %></h2>
            <% } else { %>
                <h2>Votre candidature a bien été prise en compte !</h2>
                <p>Merci d'avoir postulé à l'offre n°<%= id_offre %>.</p>
            <% } %>
        </div>
        <a href="/offre/candidat" class="btn btn-primary">Retour à l'accueil</a>
    </div>
</body>
</html>
